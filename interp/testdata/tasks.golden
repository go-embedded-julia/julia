{"src":"\nmutable struct Log; v::Any; end\nconst LOG = Log(())\nnote(x) = (setfield!(LOG, :v, (getfield(LOG, :v)..., x)); nothing)\ncur() = ccall(:jl_get_current_task, Ref{Core.Task}, ())\nnewtask(f) = ccall(:jl_new_task, Ref{Core.Task}, (Any, Any, Int), f, nothing, 0)\nsetnext(t) = ccall(:jl_set_next_task, Cvoid, (Any,), t)\ngetnext() = ccall(:jl_get_next_task, Ref{Core.Task}, ())\ndoswitch() = ccall(:jl_switch, Cvoid, ())\nstarted(t) = ccall(:jl_is_task_started, Int32, (Any,), t)\ntid(t) = ccall(:jl_get_task_tid, Int16, (Any,), t)\nstate(t) = getfield(t, :_state)\nresult(t) = getfield(t, :result)\ni8(x) = Core.Intrinsics.trunc_int(Int8, x)\ni16(x) = Core.Intrinsics.trunc_int(Int16, x)\ni32(x) = Core.Intrinsics.trunc_int(Int32, x)\nu64(x) = Core.Intrinsics.bitcast(UInt64, x)\nroot = cur()\n# switch to t and come back when it finishes: the root task is queued, and\n# what runs when a task ends is the queue's\nfunction run(t)\n    Base.schedule(root)\n    setnext(t)\n    doswitch()\nend\n# a task starts on its first switch, and a switch back and forth keeps its place\nt1 = newtask(() -> begin\n    note(:t1_start)\n    setnext(root); doswitch()\n    note(:t1_resumed)\n    setnext(root); doswitch()\nend)\nnote(started(t1))\nsetnext(t1); doswitch()\nnote(:back)\nnote((started(t1), tid(t1)))\nsetnext(t1); doswitch()\nnote(:back2)\ngetfield(LOG, :v)\n","want":"(0, :t1_start, :back, (1, 0), :t1_resumed, :back2)"}
{"src":"\nmutable struct Log; v::Any; end\nconst LOG = Log(())\nnote(x) = (setfield!(LOG, :v, (getfield(LOG, :v)..., x)); nothing)\ncur() = ccall(:jl_get_current_task, Ref{Core.Task}, ())\nnewtask(f) = ccall(:jl_new_task, Ref{Core.Task}, (Any, Any, Int), f, nothing, 0)\nsetnext(t) = ccall(:jl_set_next_task, Cvoid, (Any,), t)\ngetnext() = ccall(:jl_get_next_task, Ref{Core.Task}, ())\ndoswitch() = ccall(:jl_switch, Cvoid, ())\nstarted(t) = ccall(:jl_is_task_started, Int32, (Any,), t)\ntid(t) = ccall(:jl_get_task_tid, Int16, (Any,), t)\nstate(t) = getfield(t, :_state)\nresult(t) = getfield(t, :result)\ni8(x) = Core.Intrinsics.trunc_int(Int8, x)\ni16(x) = Core.Intrinsics.trunc_int(Int16, x)\ni32(x) = Core.Intrinsics.trunc_int(Int32, x)\nu64(x) = Core.Intrinsics.bitcast(UInt64, x)\nroot = cur()\n# switch to t and come back when it finishes: the root task is queued, and\n# what runs when a task ends is the queue's\nfunction run(t)\n    Base.schedule(root)\n    setnext(t)\n    doswitch()\nend\n# a finished task is done, with its value as its result\nt = newtask(() -> (note(:body); 42))\nnote(started(t))\nrun(t)\nnote((started(t), state(t), result(t), getfield(t, :_isexception)))\ngetfield(LOG, :v)\n","want":"(0, :body, (1, 0x01, 42, false))"}
{"src":"\nmutable struct Log; v::Any; end\nconst LOG = Log(())\nnote(x) = (setfield!(LOG, :v, (getfield(LOG, :v)..., x)); nothing)\ncur() = ccall(:jl_get_current_task, Ref{Core.Task}, ())\nnewtask(f) = ccall(:jl_new_task, Ref{Core.Task}, (Any, Any, Int), f, nothing, 0)\nsetnext(t) = ccall(:jl_set_next_task, Cvoid, (Any,), t)\ngetnext() = ccall(:jl_get_next_task, Ref{Core.Task}, ())\ndoswitch() = ccall(:jl_switch, Cvoid, ())\nstarted(t) = ccall(:jl_is_task_started, Int32, (Any,), t)\ntid(t) = ccall(:jl_get_task_tid, Int16, (Any,), t)\nstate(t) = getfield(t, :_state)\nresult(t) = getfield(t, :result)\ni8(x) = Core.Intrinsics.trunc_int(Int8, x)\ni16(x) = Core.Intrinsics.trunc_int(Int16, x)\ni32(x) = Core.Intrinsics.trunc_int(Int32, x)\nu64(x) = Core.Intrinsics.bitcast(UInt64, x)\nroot = cur()\n# switch to t and come back when it finishes: the root task is queued, and\n# what runs when a task ends is the queue's\nfunction run(t)\n    Base.schedule(root)\n    setnext(t)\n    doswitch()\nend\n# an exception in the body fails the task, and is its result\nt = newtask(() -> throw(ErrorException(\"boom\")))\nrun(t)\n(state(t), result(t), getfield(t, :_isexception))\n","want":"(0x02, ErrorException(\"boom\"), true)"}
{"src":"\nmutable struct Log; v::Any; end\nconst LOG = Log(())\nnote(x) = (setfield!(LOG, :v, (getfield(LOG, :v)..., x)); nothing)\ncur() = ccall(:jl_get_current_task, Ref{Core.Task}, ())\nnewtask(f) = ccall(:jl_new_task, Ref{Core.Task}, (Any, Any, Int), f, nothing, 0)\nsetnext(t) = ccall(:jl_set_next_task, Cvoid, (Any,), t)\ngetnext() = ccall(:jl_get_next_task, Ref{Core.Task}, ())\ndoswitch() = ccall(:jl_switch, Cvoid, ())\nstarted(t) = ccall(:jl_is_task_started, Int32, (Any,), t)\ntid(t) = ccall(:jl_get_task_tid, Int16, (Any,), t)\nstate(t) = getfield(t, :_state)\nresult(t) = getfield(t, :result)\ni8(x) = Core.Intrinsics.trunc_int(Int8, x)\ni16(x) = Core.Intrinsics.trunc_int(Int16, x)\ni32(x) = Core.Intrinsics.trunc_int(Int32, x)\nu64(x) = Core.Intrinsics.bitcast(UInt64, x)\nroot = cur()\n# switch to t and come back when it finishes: the root task is queued, and\n# what runs when a task ends is the queue's\nfunction run(t)\n    Base.schedule(root)\n    setnext(t)\n    doswitch()\nend\n# an exception that was caught and thrown again leaves the same way\nt = newtask(() -> try\n    throw(ErrorException(\"a\"))\ncatch e\n    note(:caught)\n    ccall(:jl_rethrow, Cvoid, ())\nend)\nrun(t)\n(state(t), result(t), getfield(LOG, :v))\n","want":"(0x02, ErrorException(\"a\"), (:caught,))"}
{"src":"\nmutable struct Log; v::Any; end\nconst LOG = Log(())\nnote(x) = (setfield!(LOG, :v, (getfield(LOG, :v)..., x)); nothing)\ncur() = ccall(:jl_get_current_task, Ref{Core.Task}, ())\nnewtask(f) = ccall(:jl_new_task, Ref{Core.Task}, (Any, Any, Int), f, nothing, 0)\nsetnext(t) = ccall(:jl_set_next_task, Cvoid, (Any,), t)\ngetnext() = ccall(:jl_get_next_task, Ref{Core.Task}, ())\ndoswitch() = ccall(:jl_switch, Cvoid, ())\nstarted(t) = ccall(:jl_is_task_started, Int32, (Any,), t)\ntid(t) = ccall(:jl_get_task_tid, Int16, (Any,), t)\nstate(t) = getfield(t, :_state)\nresult(t) = getfield(t, :result)\ni8(x) = Core.Intrinsics.trunc_int(Int8, x)\ni16(x) = Core.Intrinsics.trunc_int(Int16, x)\ni32(x) = Core.Intrinsics.trunc_int(Int32, x)\nu64(x) = Core.Intrinsics.bitcast(UInt64, x)\nroot = cur()\n# switch to t and come back when it finishes: the root task is queued, and\n# what runs when a task ends is the queue's\nfunction run(t)\n    Base.schedule(root)\n    setnext(t)\n    doswitch()\nend\n# throwto: an exception put in a task before it starts is its result, and the\n# body never runs\nt = newtask(() -> (note(:never); 1))\nsetfield!(t, :result, ErrorException(\"x\"))\nsetfield!(t, :_isexception, true)\nrun(t)\n(started(t), state(t), result(t), getfield(LOG, :v))\n","want":"(1, 0x02, ErrorException(\"x\"), ())"}
{"src":"\nmutable struct Log; v::Any; end\nconst LOG = Log(())\nnote(x) = (setfield!(LOG, :v, (getfield(LOG, :v)..., x)); nothing)\ncur() = ccall(:jl_get_current_task, Ref{Core.Task}, ())\nnewtask(f) = ccall(:jl_new_task, Ref{Core.Task}, (Any, Any, Int), f, nothing, 0)\nsetnext(t) = ccall(:jl_set_next_task, Cvoid, (Any,), t)\ngetnext() = ccall(:jl_get_next_task, Ref{Core.Task}, ())\ndoswitch() = ccall(:jl_switch, Cvoid, ())\nstarted(t) = ccall(:jl_is_task_started, Int32, (Any,), t)\ntid(t) = ccall(:jl_get_task_tid, Int16, (Any,), t)\nstate(t) = getfield(t, :_state)\nresult(t) = getfield(t, :result)\ni8(x) = Core.Intrinsics.trunc_int(Int8, x)\ni16(x) = Core.Intrinsics.trunc_int(Int16, x)\ni32(x) = Core.Intrinsics.trunc_int(Int32, x)\nu64(x) = Core.Intrinsics.bitcast(UInt64, x)\nroot = cur()\n# switch to t and come back when it finishes: the root task is queued, and\n# what runs when a task ends is the queue's\nfunction run(t)\n    Base.schedule(root)\n    setnext(t)\n    doswitch()\nend\n# get_next_task is the current task until set_next_task says otherwise\nt = newtask(() -> 1)\na = getnext() === root\nsetnext(t)\nb = getnext() === t\nsetnext(root)\n(a, b, getnext() === root)\n","want":"(true, true, true)"}
{"src":"\nmutable struct Log; v::Any; end\nconst LOG = Log(())\nnote(x) = (setfield!(LOG, :v, (getfield(LOG, :v)..., x)); nothing)\ncur() = ccall(:jl_get_current_task, Ref{Core.Task}, ())\nnewtask(f) = ccall(:jl_new_task, Ref{Core.Task}, (Any, Any, Int), f, nothing, 0)\nsetnext(t) = ccall(:jl_set_next_task, Cvoid, (Any,), t)\ngetnext() = ccall(:jl_get_next_task, Ref{Core.Task}, ())\ndoswitch() = ccall(:jl_switch, Cvoid, ())\nstarted(t) = ccall(:jl_is_task_started, Int32, (Any,), t)\ntid(t) = ccall(:jl_get_task_tid, Int16, (Any,), t)\nstate(t) = getfield(t, :_state)\nresult(t) = getfield(t, :result)\ni8(x) = Core.Intrinsics.trunc_int(Int8, x)\ni16(x) = Core.Intrinsics.trunc_int(Int16, x)\ni32(x) = Core.Intrinsics.trunc_int(Int32, x)\nu64(x) = Core.Intrinsics.bitcast(UInt64, x)\nroot = cur()\n# switch to t and come back when it finishes: the root task is queued, and\n# what runs when a task ends is the queue's\nfunction run(t)\n    Base.schedule(root)\n    setnext(t)\n    doswitch()\nend\n# a switch to the current task returns at once\nsetnext(root); doswitch()\nnote(:still_here)\ngetfield(LOG, :v)\n","want":"(:still_here,)"}
{"src":"\nmutable struct Log; v::Any; end\nconst LOG = Log(())\nnote(x) = (setfield!(LOG, :v, (getfield(LOG, :v)..., x)); nothing)\ncur() = ccall(:jl_get_current_task, Ref{Core.Task}, ())\nnewtask(f) = ccall(:jl_new_task, Ref{Core.Task}, (Any, Any, Int), f, nothing, 0)\nsetnext(t) = ccall(:jl_set_next_task, Cvoid, (Any,), t)\ngetnext() = ccall(:jl_get_next_task, Ref{Core.Task}, ())\ndoswitch() = ccall(:jl_switch, Cvoid, ())\nstarted(t) = ccall(:jl_is_task_started, Int32, (Any,), t)\ntid(t) = ccall(:jl_get_task_tid, Int16, (Any,), t)\nstate(t) = getfield(t, :_state)\nresult(t) = getfield(t, :result)\ni8(x) = Core.Intrinsics.trunc_int(Int8, x)\ni16(x) = Core.Intrinsics.trunc_int(Int16, x)\ni32(x) = Core.Intrinsics.trunc_int(Int32, x)\nu64(x) = Core.Intrinsics.bitcast(UInt64, x)\nroot = cur()\n# switch to t and come back when it finishes: the root task is queued, and\n# what runs when a task ends is the queue's\nfunction run(t)\n    Base.schedule(root)\n    setnext(t)\n    doswitch()\nend\n# a task that finished cannot be switched to again\nt = newtask(() -> 1)\nrun(t)\nr = try\n    setnext(t); doswitch()\n    :switched\ncatch e\n    e\nend\n(r, state(t))\n","want":"(ErrorException(\"attempt to switch to exited task\"), 0x01)"}
{"src":"\nmutable struct Log; v::Any; end\nconst LOG = Log(())\nnote(x) = (setfield!(LOG, :v, (getfield(LOG, :v)..., x)); nothing)\ncur() = ccall(:jl_get_current_task, Ref{Core.Task}, ())\nnewtask(f) = ccall(:jl_new_task, Ref{Core.Task}, (Any, Any, Int), f, nothing, 0)\nsetnext(t) = ccall(:jl_set_next_task, Cvoid, (Any,), t)\ngetnext() = ccall(:jl_get_next_task, Ref{Core.Task}, ())\ndoswitch() = ccall(:jl_switch, Cvoid, ())\nstarted(t) = ccall(:jl_is_task_started, Int32, (Any,), t)\ntid(t) = ccall(:jl_get_task_tid, Int16, (Any,), t)\nstate(t) = getfield(t, :_state)\nresult(t) = getfield(t, :result)\ni8(x) = Core.Intrinsics.trunc_int(Int8, x)\ni16(x) = Core.Intrinsics.trunc_int(Int16, x)\ni32(x) = Core.Intrinsics.trunc_int(Int32, x)\nu64(x) = Core.Intrinsics.bitcast(UInt64, x)\nroot = cur()\n# switch to t and come back when it finishes: the root task is queued, and\n# what runs when a task ends is the queue's\nfunction run(t)\n    Base.schedule(root)\n    setnext(t)\n    doswitch()\nend\n# a task started by a task runs, and the tasks hand over in turn: when the\n# inner one ends the outer one, queued before it switched, runs on\ninner = newtask(() -> (note(:inner); 2))\nouter = newtask(() -> begin\n    note(:outer_start)\n    Base.schedule(cur())\n    setnext(inner); doswitch()\n    note(:outer_end)\n    Base.schedule(root)\n    3\nend)\nsetnext(outer); doswitch()\n(getfield(LOG, :v), result(outer), result(inner), state(outer), state(inner))\n","want":"((:outer_start, :inner, :outer_end), 3, 2, 0x01, 0x01)"}
{"src":"\nmutable struct Log; v::Any; end\nconst LOG = Log(())\nnote(x) = (setfield!(LOG, :v, (getfield(LOG, :v)..., x)); nothing)\ncur() = ccall(:jl_get_current_task, Ref{Core.Task}, ())\nnewtask(f) = ccall(:jl_new_task, Ref{Core.Task}, (Any, Any, Int), f, nothing, 0)\nsetnext(t) = ccall(:jl_set_next_task, Cvoid, (Any,), t)\ngetnext() = ccall(:jl_get_next_task, Ref{Core.Task}, ())\ndoswitch() = ccall(:jl_switch, Cvoid, ())\nstarted(t) = ccall(:jl_is_task_started, Int32, (Any,), t)\ntid(t) = ccall(:jl_get_task_tid, Int16, (Any,), t)\nstate(t) = getfield(t, :_state)\nresult(t) = getfield(t, :result)\ni8(x) = Core.Intrinsics.trunc_int(Int8, x)\ni16(x) = Core.Intrinsics.trunc_int(Int16, x)\ni32(x) = Core.Intrinsics.trunc_int(Int32, x)\nu64(x) = Core.Intrinsics.bitcast(UInt64, x)\nroot = cur()\n# switch to t and come back when it finishes: the root task is queued, and\n# what runs when a task ends is the queue's\nfunction run(t)\n    Base.schedule(root)\n    setnext(t)\n    doswitch()\nend\n# a new task has the state of julia's jl_new_task\nt = newtask(() -> 1)\n(state(t), getfield(t, :sticky), getfield(t, :priority), getfield(t, :_isexception), getfield(t, :result), getfield(t, :next), getfield(t, :queue), getfield(t, :storage), getfield(t, :donenotify), started(t), tid(t))\n","want":"(0x00, true, 0x0000, false, nothing, nothing, nothing, nothing, nothing, 0, -1)"}
{"src":"\nmutable struct Log; v::Any; end\nconst LOG = Log(())\nnote(x) = (setfield!(LOG, :v, (getfield(LOG, :v)..., x)); nothing)\ncur() = ccall(:jl_get_current_task, Ref{Core.Task}, ())\nnewtask(f) = ccall(:jl_new_task, Ref{Core.Task}, (Any, Any, Int), f, nothing, 0)\nsetnext(t) = ccall(:jl_set_next_task, Cvoid, (Any,), t)\ngetnext() = ccall(:jl_get_next_task, Ref{Core.Task}, ())\ndoswitch() = ccall(:jl_switch, Cvoid, ())\nstarted(t) = ccall(:jl_is_task_started, Int32, (Any,), t)\ntid(t) = ccall(:jl_get_task_tid, Int16, (Any,), t)\nstate(t) = getfield(t, :_state)\nresult(t) = getfield(t, :result)\ni8(x) = Core.Intrinsics.trunc_int(Int8, x)\ni16(x) = Core.Intrinsics.trunc_int(Int16, x)\ni32(x) = Core.Intrinsics.trunc_int(Int32, x)\nu64(x) = Core.Intrinsics.bitcast(UInt64, x)\nroot = cur()\n# switch to t and come back when it finishes: the root task is queued, and\n# what runs when a task ends is the queue's\nfunction run(t)\n    Base.schedule(root)\n    setnext(t)\n    doswitch()\nend\n# a task that is not sticky is free of its thread once it stops running, and\n# the thread of the running task is its tid\nt = newtask(() -> (note(ccall(:jl_threadid, Int16, ())); setnext(root); doswitch()))\nsetfield!(t, :sticky, false)\nsetnext(t); doswitch()\n(ccall(:jl_threadid, Int16, ()), tid(t), getfield(LOG, :v))\n","want":"(0, -1, (0,))"}
{"src":"\nmutable struct Log; v::Any; end\nconst LOG = Log(())\nnote(x) = (setfield!(LOG, :v, (getfield(LOG, :v)..., x)); nothing)\ncur() = ccall(:jl_get_current_task, Ref{Core.Task}, ())\nnewtask(f) = ccall(:jl_new_task, Ref{Core.Task}, (Any, Any, Int), f, nothing, 0)\nsetnext(t) = ccall(:jl_set_next_task, Cvoid, (Any,), t)\ngetnext() = ccall(:jl_get_next_task, Ref{Core.Task}, ())\ndoswitch() = ccall(:jl_switch, Cvoid, ())\nstarted(t) = ccall(:jl_is_task_started, Int32, (Any,), t)\ntid(t) = ccall(:jl_get_task_tid, Int16, (Any,), t)\nstate(t) = getfield(t, :_state)\nresult(t) = getfield(t, :result)\ni8(x) = Core.Intrinsics.trunc_int(Int8, x)\ni16(x) = Core.Intrinsics.trunc_int(Int16, x)\ni32(x) = Core.Intrinsics.trunc_int(Int32, x)\nu64(x) = Core.Intrinsics.bitcast(UInt64, x)\nroot = cur()\n# switch to t and come back when it finishes: the root task is queued, and\n# what runs when a task ends is the queue's\nfunction run(t)\n    Base.schedule(root)\n    setnext(t)\n    doswitch()\nend\n# jl_set_task_tid claims a task for a thread once, and answers again for the same thread\nt = newtask(() -> 1)\na = ccall(:jl_set_task_tid, Int32, (Any, Int32), t, i32(1))\nb = ccall(:jl_set_task_tid, Int32, (Any, Int32), t, i32(0))\n(a, b, tid(t))\n","want":"(1, 0, 1)"}
{"src":"\nmutable struct Log; v::Any; end\nconst LOG = Log(())\nnote(x) = (setfield!(LOG, :v, (getfield(LOG, :v)..., x)); nothing)\ncur() = ccall(:jl_get_current_task, Ref{Core.Task}, ())\nnewtask(f) = ccall(:jl_new_task, Ref{Core.Task}, (Any, Any, Int), f, nothing, 0)\nsetnext(t) = ccall(:jl_set_next_task, Cvoid, (Any,), t)\ngetnext() = ccall(:jl_get_next_task, Ref{Core.Task}, ())\ndoswitch() = ccall(:jl_switch, Cvoid, ())\nstarted(t) = ccall(:jl_is_task_started, Int32, (Any,), t)\ntid(t) = ccall(:jl_get_task_tid, Int16, (Any,), t)\nstate(t) = getfield(t, :_state)\nresult(t) = getfield(t, :result)\ni8(x) = Core.Intrinsics.trunc_int(Int8, x)\ni16(x) = Core.Intrinsics.trunc_int(Int16, x)\ni32(x) = Core.Intrinsics.trunc_int(Int32, x)\nu64(x) = Core.Intrinsics.bitcast(UInt64, x)\nroot = cur()\n# switch to t and come back when it finishes: the root task is queued, and\n# what runs when a task ends is the queue's\nfunction run(t)\n    Base.schedule(root)\n    setnext(t)\n    doswitch()\nend\n# a task claimed by another thread cannot be switched to from this one\nt = newtask(() -> 1)\nccall(:jl_set_task_tid, Int32, (Any, Int32), t, i32(1))\nr = try\n    setnext(t); doswitch()\n    :switched\ncatch e\n    e\nend\n(r, started(t), tid(t))\n","want":"(ErrorException(\"cannot switch to task running on another thread\"), 0, 1)"}
{"src":"\nmutable struct Log; v::Any; end\nconst LOG = Log(())\nnote(x) = (setfield!(LOG, :v, (getfield(LOG, :v)..., x)); nothing)\ncur() = ccall(:jl_get_current_task, Ref{Core.Task}, ())\nnewtask(f) = ccall(:jl_new_task, Ref{Core.Task}, (Any, Any, Int), f, nothing, 0)\nsetnext(t) = ccall(:jl_set_next_task, Cvoid, (Any,), t)\ngetnext() = ccall(:jl_get_next_task, Ref{Core.Task}, ())\ndoswitch() = ccall(:jl_switch, Cvoid, ())\nstarted(t) = ccall(:jl_is_task_started, Int32, (Any,), t)\ntid(t) = ccall(:jl_get_task_tid, Int16, (Any,), t)\nstate(t) = getfield(t, :_state)\nresult(t) = getfield(t, :result)\ni8(x) = Core.Intrinsics.trunc_int(Int8, x)\ni16(x) = Core.Intrinsics.trunc_int(Int16, x)\ni32(x) = Core.Intrinsics.trunc_int(Int32, x)\nu64(x) = Core.Intrinsics.bitcast(UInt64, x)\nroot = cur()\n# switch to t and come back when it finishes: the root task is queued, and\n# what runs when a task ends is the queue's\nfunction run(t)\n    Base.schedule(root)\n    setnext(t)\n    doswitch()\nend\n# a task's random state comes from its creator's, and the creator's advances\nr0 = (getfield(root, :rngState4), getfield(root, :rngState0))\nt = newtask(() -> 1)\nr1 = (getfield(root, :rngState4), getfield(root, :rngState0))\n(r0 === r1, getfield(t, :rngState4) === getfield(root, :rngState4), getfield(t, :rngState0) === getfield(root, :rngState0))\n","want":"(false, true, false)"}
